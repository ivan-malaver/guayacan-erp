{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": { "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] }
    },
    {
      "name": "recursos",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"] }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogos",
      "urls": ["/api/v1/inventario/productos/**", "/api/v1/nucleo/zonas/**", "/api/v1/produccion/especies/**", "/api/v1/nucleo/mis-fincas/"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 200, "maxAge": "7d", "timeout": "4s" }
    }
  ]
}
