# PLANTILLA de variables de entorno de GuayacanERP.
# CÓMO USARLA: copie este archivo como .env (en la misma carpeta) y cambie cada «cambiar...» por un valor propio.
#   PowerShell:  Copy-Item .env.ejemplo .env
# El archivo .env tiene sus claves reales: está en .gitignore y NUNCA se sube a GitHub. Este ejemplo sí se sube.
# Lo leen docker-compose.yml, Django (config/settings/base.py, con python-dotenv) y los servicios FastAPI.

# --- PostgreSQL ---
# Clave del usuario dueño (postgres). Solo para cargar el esquema y migrar las tablas internas de Django.
POSTGRES_PASSWORD=cambiar_esta_clave
# Usuario con que entra la API (miembro del rol guayacan_app, con permisos limitados; lo crea backend/sql/preparar_api.sql)
POSTGRES_API_USUARIO=guayacan_api
POSTGRES_API_CLAVE=cambiar_esta_clave
# Servidor de la base: localhost cuando Django corre en su PC; "postgres" cuando corre dentro de Docker
POSTGRES_HOST=localhost

# --- MongoDB (conversaciones y mensajes) ---
MONGO_USUARIO=guayacan
MONGO_CLAVE=cambiar_esta_clave

# --- MinIO (archivos: fotos, documentos, videos) ---
MINIO_USUARIO=guayacan
MINIO_CLAVE=cambiar_esta_clave_larga

# --- Django ---
# Clave secreta para firmar sesiones y tokens. Genérela con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar_por_una_cadena_larga_y_aleatoria
# Nombres de servidor permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Direcciones del frontend que pueden llamar a la API desde el navegador (CORS)
CORS_ORIGENES=http://localhost:4200
# Redis para Celery y eventos
REDIS_URL=redis://localhost:6379/0

# --- Servicio de agentes y canales (Meta: WhatsApp, Instagram, Messenger) ---
# Token que usted inventa y escribe también en la consola de Meta al registrar el webhook
META_TOKEN_VERIFICACION=cambiar
# Secreto de la app de Meta (developers.facebook.com > su app > Configuración básica)
META_SECRETO_APP=cambiar

# --- Pasarela de pagos (ADO-02; hoy simulada, luego Wompi) ---
# Secreto con que la pasarela firma los avisos de pago. Sin él la API rechaza todo aviso
PASARELA_SECRETO=cambiar_secreto_pasarela

# --- Puente IoT (fase 4) ---
# Secreto compartido con la pasarela de la finca
TOKEN_PASARELA=cambiar
