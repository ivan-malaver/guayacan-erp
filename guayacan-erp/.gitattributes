# .gitattributes: cómo trata Git los finales de línea y los binarios.
# POR QUÉ: Windows termina las líneas con CRLF y Linux con LF. Los scripts .sh y los .sql cargados en Docker
# fallan con CRLF. Con esto, Git guarda todo con LF y en su PC lo verá igual en VS Code.
* text=auto eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.ts   text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.mmd  text eol=lf
*.dot  text eol=lf
*.ps1  text eol=crlf
# Binarios: Git no intenta compararlos ni cambiarles los finales de línea
*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.zip  binary
