{
  "conversaciones": {
    "fase": 1,
    "descripcion": "Una conversación con un cliente o visitante por un canal (WhatsApp, web, Instagram, Facebook). Agrupa los mensajes.",
    "validador": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "predio_id",
          "canal",
          "identificador_canal",
          "estado",
          "consentimiento_vigente",
          "iniciada_en",
          "ultima_actividad_en"
        ],
        "properties": {
          "predio_id": {
            "bsonType": "long",
            "description": "Finca dueña del documento (nucleo.predio.id). MongoDB no tiene seguridad por filas: el servicio de agentes filtra siempre por este campo"
          },
          "canal": {
            "bsonType": "string",
            "description": "Canal de la conversación (redes.politica_canal)",
            "enum": [
              "whatsapp",
              "web_chat",
              "instagram",
              "messenger",
              "tiktok"
            ]
          },
          "origen_entrada": {
            "bsonType": "string",
            "description": "Cómo llegó el cliente; un anuncio que abre chat amplía la ventana",
            "enum": [
              "organico",
              "anuncio",
              "qr",
              "enlace_perfil",
              "comentario"
            ]
          },
          "ultimo_mensaje_cliente_en": {
            "bsonType": "date",
            "description": "Último mensaje del cliente: desde aquí corre la ventana del canal"
          },
          "ventana_cierra_en": {
            "bsonType": "date",
            "description": "Hasta cuándo puede responder el agente de IA sin plantilla"
          },
          "ventana_humano_cierra_en": {
            "bsonType": "date",
            "description": "Hasta cuándo puede responder una persona (Instagram y Messenger: 7 días)"
          },
          "mensajes_en_ventana": {
            "bsonType": "int",
            "description": "Mensajes enviados en la ventana actual (TikTok permite 10)"
          },
          "escalamiento_id": {
            "bsonType": "long",
            "description": "Escalamiento abierto (ia.escalamiento.id)"
          },
          "identificador_canal": {
            "bsonType": "string",
            "description": "Número de WhatsApp o id del usuario en la plataforma (cifrado si es personal)"
          },
          "tercero_id": {
            "bsonType": "long",
            "description": "Tercero en PostgreSQL, cuando se identifica al cliente"
          },
          "estado": {
            "bsonType": "string",
            "description": "Situación",
            "enum": [
              "abierta",
              "en_espera_humano",
              "atendida_humano",
              "fuera_de_ventana",
              "cerrada"
            ]
          },
          "agente_actual": {
            "bsonType": "string",
            "description": "Código del agente que atiende (ia.agente.codigo)"
          },
          "intencion": {
            "bsonType": "string",
            "description": "Intención detectada por el orquestador",
            "enum": [
              "consulta_producto",
              "pedido",
              "estado_pedido",
              "turismo",
              "queja",
              "proveedor",
              "otro"
            ]
          },
          "resumen": {
            "bsonType": "string",
            "description": "Resumen corto que actualiza el agente al cerrar (memoria de corto plazo)"
          },
          "pedido_ids": {
            "bsonType": "array",
            "description": "Pedidos creados en esta conversación (comercial.pedido.id)"
          },
          "consentimiento_vigente": {
            "bsonType": "bool",
            "description": "Copia de control: si el cliente autorizó personalización al iniciar"
          },
          "iniciada_en": {
            "bsonType": "date",
            "description": "Primer mensaje"
          },
          "ultima_actividad_en": {
            "bsonType": "date",
            "description": "Último mensaje"
          }
        }
      }
    },
    "indices": [
      {
        "canal": 1,
        "identificador_canal": 1,
        "ultima_actividad_en": -1
      },
      {
        "tercero_id": 1
      },
      {
        "estado": 1
      }
    ],
    "ttl_dias": null
  },
  "mensajes": {
    "fase": 1,
    "descripcion": "Cada mensaje de una conversación, del cliente, de un agente o de una persona del equipo.",
    "validador": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "predio_id",
          "conversacion_id",
          "autor",
          "tipo",
          "enviado_en"
        ],
        "properties": {
          "predio_id": {
            "bsonType": "long",
            "description": "Finca dueña del documento (nucleo.predio.id). MongoDB no tiene seguridad por filas: el servicio de agentes filtra siempre por este campo"
          },
          "conversacion_id": {
            "bsonType": "objectId",
            "description": "Conversación"
          },
          "autor": {
            "bsonType": "string",
            "description": "Quién escribe",
            "enum": [
              "cliente",
              "agente",
              "humano",
              "sistema"
            ]
          },
          "agente": {
            "bsonType": "string",
            "description": "Código del agente, si lo escribió un agente"
          },
          "usuario_id": {
            "bsonType": "long",
            "description": "Usuario del equipo, si lo escribió una persona"
          },
          "tipo": {
            "bsonType": "string",
            "description": "Tipo de contenido",
            "enum": [
              "texto",
              "imagen",
              "audio",
              "ubicacion",
              "plantilla",
              "botones"
            ]
          },
          "texto": {
            "bsonType": "string",
            "description": "Contenido de texto (o transcripción del audio)"
          },
          "audio_url": {
            "bsonType": "string",
            "description": "Nota de voz del cliente en el almacén de archivos (se conserva hasta su vencimiento)"
          },
          "transcripcion": {
            "bsonType": "string",
            "description": "Texto obtenido del audio por el servicio de voz a texto"
          },
          "confianza_transcripcion": {
            "bsonType": "double",
            "description": "Confianza del servicio de voz a texto, de 0 a 1; si es baja, el agente pide confirmar"
          },
          "proveedor_voz_texto": {
            "bsonType": "string",
            "description": "Servicio de voz a texto usado (intercambiable)"
          },
          "pieza_audiovisual_id": {
            "bsonType": "long",
            "description": "Video aprobado que el asesor adjuntó (redes.pieza_audiovisual)"
          },
          "adjuntos": {
            "bsonType": "array",
            "description": "Rutas en MinIO de imágenes o audios"
          },
          "herramientas_usadas": {
            "bsonType": "array",
            "description": "Herramientas que el agente invocó para responder (códigos)"
          },
          "ejecucion_id": {
            "bsonType": "objectId",
            "description": "Registro en bitacora_agentes con el detalle"
          },
          "enviado_en": {
            "bsonType": "date",
            "description": "Momento"
          }
        }
      }
    },
    "indices": [
      {
        "conversacion_id": 1,
        "enviado_en": 1
      }
    ],
    "ttl_dias": 730
  },
  "perfiles_interes": {
    "fase": 1,
    "descripcion": "Lo que se sabe de los intereses de cada cliente para personalizar ofertas. Solo se llena si su consentimiento de personalización está vigente.",
    "validador": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "predio_id",
          "tercero_id",
          "intereses",
          "consentimiento_id",
          "actualizado_en"
        ],
        "properties": {
          "predio_id": {
            "bsonType": "long",
            "description": "Finca dueña del documento (nucleo.predio.id). MongoDB no tiene seguridad por filas: el servicio de agentes filtra siempre por este campo"
          },
          "tercero_id": {
            "bsonType": "long",
            "description": "Cliente (terceros.tercero.id)"
          },
          "intereses": {
            "bsonType": "array",
            "description": "Lista de productos o temas con puntaje: {producto_id, tema, puntaje 0-1, fuente, actualizado_en}"
          },
          "preferencias_declaradas": {
            "bsonType": "object",
            "description": "Lo que el cliente dijo explícitamente (presentación, día de entrega, alergias que mencione)"
          },
          "canal_preferido": {
            "bsonType": "string",
            "description": "Canal por el que más responde"
          },
          "horario_preferido": {
            "bsonType": "string",
            "description": "Franja en que suele comprar"
          },
          "segmentos": {
            "bsonType": "array",
            "description": "Segmentos calculados (ej. comprador_semanal_huevo)"
          },
          "resumen_memoria": {
            "bsonType": "string",
            "description": "Memoria de largo plazo en lenguaje natural que lee el vendedor personalizado"
          },
          "consentimiento_id": {
            "bsonType": "long",
            "description": "Consentimiento que lo autoriza (terceros.consentimiento_datos.id)"
          },
          "actualizado_en": {
            "bsonType": "date",
            "description": "Última actualización"
          }
        }
      }
    },
    "indices": [
      {
        "tercero_id": 1
      }
    ],
    "ttl_dias": null
  },
  "eventos_redes": {
    "fase": 2,
