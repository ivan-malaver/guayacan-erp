  "bitacora_agentes": {
    "fase": 1,
    "descripcion": "Registro detallado de cada ejecución de un agente: qué recibió, qué herramientas usó, qué respondió, cuánto costó y cuánto tardó. Base para auditar y mejorar.",
    "validador": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "predio_id",
          "agente",
          "version_instrucciones",
          "modelo",
          "disparador",
          "entrada_resumen",
          "pasos",
          "tokens_entrada",
          "tokens_salida",
          "costo_usd",
          "latencia_ms",
          "ejecutado_en"
        ],
        "properties": {
          "predio_id": {
            "bsonType": "long",
            "description": "Finca dueña del documento (nucleo.predio.id). MongoDB no tiene seguridad por filas: el servicio de agentes filtra siempre por este campo"
          },
          "agente": {
            "bsonType": "string",
            "description": "Código del agente"
          },
          "version_instrucciones": {
            "bsonType": "string",
            "description": "Versión de instrucciones usada"
          },
          "modelo": {
            "bsonType": "string",
            "description": "Modelo usado"
          },
          "disparador": {
            "bsonType": "string",
            "description": "Qué la inició",
            "enum": [
              "mensaje",
              "tarea_programada",
              "evento",
              "humano"
            ]
          },
          "entrada_resumen": {
            "bsonType": "string",
            "description": "Resumen de la entrada (sin datos sensibles)"
          },
          "pasos": {
            "bsonType": "array",
            "description": "Secuencia {herramienta, parametros, resultado_resumen, duracion_ms}"
          },
          "salida_resumen": {
            "bsonType": "string",
            "description": "Resumen de la respuesta"
          },
          "tokens_entrada": {
            "bsonType": "int",
            "description": "Tokens enviados"
          },
          "tokens_salida": {
            "bsonType": "int",
            "description": "Tokens generados"
          },
          "costo_usd": {
            "bsonType": "double",
            "description": "Costo"
          },
          "latencia_ms": {
            "bsonType": "int",
            "description": "Duración total"
          },
          "error": {
            "bsonType": "string",
            "description": "Error, si lo hubo"
          },
          "ejecutado_en": {
            "bsonType": "date",
            "description": "Momento"
          }
        }
      }
    },
    "indices": [
      {
        "agente": 1,
        "ejecutado_en": -1
      }
    ],
    "ttl_dias": 365
  },
