"ADM" -> "TUR-01";
"CLI" -> "TUR-02";
"VEN" -> "TUR-02";
"TUR-02" -> "AG_GUI" [style=solid];
"TUR-02" -> "AGD-02" [style=dashed, arrowhead=vee, xlabel="«include»", fontsize=9.5, fontcolor="#6B7280", constraint=true];
"TUR-03" -> "TUR-02" [style=dashed, arrowhead=vee, xlabel="«extend»", fontsize=9.5, fontcolor="#6B7280", constraint=false];
"CLI" -> "TUR-03";
"TUR-03" -> "PAG" [style=solid];
"POR" -> "TUR-04";
"VEN" -> "TUR-04";
"TUR-04" -> "VIS" [style=solid];
"TUR-04" -> "AGD-04" [style=dashed, arrowhead=vee, xlabel="«include»", fontsize=9.5, fontcolor="#6B7280", constraint=true];
"OPR" -> "TUR-05";
"TUR-05" -> "VEN" [style=solid];
"TUR-05" -> "AGD-03" [style=dashed, arrowhead=vee, xlabel="«include»", fontsize=9.5, fontcolor="#6B7280", constraint=true];
"ADM" -> "TUR-06";
}