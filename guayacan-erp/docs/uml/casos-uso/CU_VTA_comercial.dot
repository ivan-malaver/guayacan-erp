"VTA-04" -> "INV-03" [style=dashed, arrowhead=vee, xlabel="«include»", fontsize=9.5, fontcolor="#6B7280", constraint=true];
"OPE" -> "VTA-05";
"VEN" -> "VTA-05";
"VTA-05" -> "GW" [style=solid];
"VTA-05" -> "INV-03" [style=dashed, arrowhead=vee, xlabel="«include»", fontsize=9.5, fontcolor="#6B7280", constraint=true];
"SCH" -> "VTA-06";
"VTA-06" -> "DIAN" [style=solid];
"VEN" -> "VTA-07";
"CON" -> "VTA-07";
"VTA-07" -> "PAG" [style=solid];
"CON" -> "VTA-08";
