digraph A {
graph [rankdir=BT, fontname="DejaVu Sans", nodesep=0.22, ranksep=0.8, pad=0.3, bgcolor=white, label="Agentes de IA: actores secundarios que proponen; una persona decide", labelloc=t, fontsize=16, fontcolor="#1F2933"];
node [fontname="DejaVu Sans"]; edge [color="#6B7280", arrowhead=empty, penwidth=1.1];
"AGT" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=11, label="«agente IA»\nAgente (propone, no decide)"];
"AG_ORQ" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nOrquestador"];
"AG_ASE" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nAsesor virtual"];
"AG_GUI" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nGuía virtual"];
"AG_VEP" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nVendedor\npersonalizado"];
"AG_RED" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nGestor de redes"];
"AG_MER" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nAnalista de\nmercados"];
"AG_NEG" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nAnalista de\nnegocio"];
"AG_CON" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nAsistente contable"];
"AG_AGR" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nAgrónomo"];
"AG_COO" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nCoordinador"];
"AG_INS" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nInstructor"];
"AG_EST" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nEstratega"];
"AG_VIG" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nVigía de seguridad"];
"AG_PRY" [shape=box, style="rounded,dashed", color="#7A4E9C", fontcolor="#7A4E9C", fontsize=10.5, label="«agente IA»\nAsistente de\nproyectos"];
"AG_ORQ" -> "AGT" [color="#7A4E9C"];
"AG_ASE" -> "AGT" [color="#7A4E9C"];
"AG_GUI" -> "AGT" [color="#7A4E9C"];
"AG_VEP" -> "AGT" [color="#7A4E9C"];
"AG_RED" -> "AGT" [color="#7A4E9C"];
"AG_MER" -> "AGT" [color="#7A4E9C"];
"AG_NEG" -> "AGT" [color="#7A4E9C"];
"AG_CON" -> "AG_ORQ" [style=invis];
"AG_CON" -> "AGT" [color="#7A4E9C", constraint=false];
"AG_AGR" -> "AG_ASE" [style=invis];
"AG_AGR" -> "AGT" [color="#7A4E9C", constraint=false];
"AG_COO" -> "AG_GUI" [style=invis];
"AG_COO" -> "AGT" [color="#7A4E9C", constraint=false];
"AG_INS" -> "AG_VEP" [style=invis];
"AG_INS" -> "AGT" [color="#7A4E9C", constraint=false];
"AG_EST" -> "AG_RED" [style=invis];
"AG_EST" -> "AGT" [color="#7A4E9C", constraint=false];
"AG_VIG" -> "AG_MER" [style=invis];
"AG_VIG" -> "AGT" [color="#7A4E9C", constraint=false];
"AG_PRY" -> "AG_NEG" [style=invis];
"AG_PRY" -> "AGT" [color="#7A4E9C", constraint=false];
}