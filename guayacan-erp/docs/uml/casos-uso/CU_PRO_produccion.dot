"OPE" [shape=none, image="/tmp/claude-0/-home-claude/7320bc6f-3622-59e9-931c-48aeb0592ea4/scratchpad/out/uml/casos-uso/actor.png", imagescale=false, imagepos=tc, labelloc=b, height=1.45, width=1.2, label="Operario de\ncampo", fontsize=11, fontcolor="#1F2933"];
subgraph cluster_sistema { label="GuayacanERP · Producción animal y agrícola"; fontsize=13; fontcolor="#2E6B4F"; color="#2E6B4F"; penwidth=1.4; style=rounded; margin=18;
  "PRO-01" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-01\nRegistrar el ingreso de un\nlote de animales"];
  "PRO-02" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-02\nRegistrar la postura\ndiaria y clasificar el\nhuevo"];
  "PRO-03" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-03\nRegistrar alimentación,\npesajes y eventos\nsanitarios"];
  "PRO-04" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-04\nRegistrar eventos\nreproductivos de ovinos y\ncaprinos"];
  "PRO-05" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-05\nRegistrar una siembra y\nsus labores culturales"];
  "PRO-06" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-06\nRegistrar una cosecha y su\ndestino"];
  "PRO-07" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-07\nRegistrar un análisis de\nsuelo y su recomendación"];
  "PRO-08" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-08\nRegistrar bioseguridad e\ninocuidad"];
  "PRO-09" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-09\nProducir abono en\nlombricultivo o compostera"];
  "PRO-10" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="PRO-10\nMedir la calidad del agua\nde los estanques"];
}
