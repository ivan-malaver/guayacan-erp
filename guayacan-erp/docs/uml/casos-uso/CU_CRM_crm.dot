subgraph cluster_sistema { label="GuayacanERP · Clientes potenciales (CRM)"; fontsize=13; fontcolor="#2E6B4F"; color="#2E6B4F"; penwidth=1.4; style=rounded; margin=18;
  "CRM-01" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="CRM-01\nCapturar un posible\ncliente con autorización"];
  "CRM-02" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="CRM-02\nGestionar segmentos y\ncampañas"];
  "CRM-03" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="CRM-03\nRegistrar interacciones y\navanzar el embudo"];
  "CRM-04" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="CRM-04\nCalificar los prospectos"];
  "CRM-05" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="CRM-05\nConvertir un prospecto en\ncliente"];
  "CRM-06" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="CRM-06\nGestionar oportunidades y\nproyectar ventas"];
}
