digraph G {
graph [rankdir=LR, fontname="DejaVu Sans", nodesep=0.28, ranksep=0.9, pad=0.3, bgcolor=white, label="Casos de uso · Estrategia de negocio (EST)", labelloc=t, fontsize=16, fontcolor="#1F2933"];
