subgraph cluster_sistema { label="GuayacanERP · Estrategia de negocio"; fontsize=13; fontcolor="#2E6B4F"; color="#2E6B4F"; penwidth=1.4; style=rounded; margin=18;
  "EST-01" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="EST-01\nMantener las líneas de\nnegocio y la matriz DOFA"];
  "EST-02" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="EST-02\nRegistrar un estudio de\nmercado"];
  "EST-03" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="EST-03\nProponer una iniciativa de\ncrecimiento"];
  "EST-04" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="EST-04\nEvaluar financieramente\nuna iniciativa"];
  "EST-05" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="EST-05\nAprobar una iniciativa"];
  "EST-06" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="EST-06\nReinvertir utilidades de\nuna línea"];
  "EST-07" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="EST-07\nSeguir el retorno de las\niniciativas"];
  "EST-08" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="EST-08\nDefinir objetivos y metas\ndel cuadro de mando"];
}
