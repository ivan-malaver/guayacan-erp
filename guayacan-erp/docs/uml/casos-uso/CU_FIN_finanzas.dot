digraph G {
graph [rankdir=LR, fontname="DejaVu Sans", nodesep=0.28, ranksep=0.9, pad=0.3, bgcolor=white, label="Casos de uso · Finanzas y contabilidad (FIN)", labelloc=t, fontsize=16, fontcolor="#1F2933"];
node [fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", color="#6B7280", arrowhead=none, penwidth=1.1];
{rank=source; "CON"; "FAM"; "SCH";}
"CON" [shape=none, image="/tmp/claude-0/-home-claude/7320bc6f-3622-59e9-931c-48aeb0592ea4/scratchpad/out/uml/casos-uso/actor.png", imagescale=false, imagepos=tc, labelloc=b, height=1.45, width=1.2, label="Contador", fontsize=11, fontcolor="#1F2933"];
"FAM" [shape=none, image="/tmp/claude-0/-home-claude/7320bc6f-3622-59e9-931c-48aeb0592ea4/scratchpad/out/uml/casos-uso/actor.png", imagescale=false, imagepos=tc, labelloc=b, height=1.45, width=1.2, label="Familia", fontsize=11, fontcolor="#1F2933"];
"SCH" [shape=box, color="#6B7280", fontcolor="#1F2933", fontsize=10.5, label="«sistema»\nTareas programadas"];
subgraph cluster_sistema { label="GuayacanERP · Finanzas y contabilidad"; fontsize=13; fontcolor="#2E6B4F"; color="#2E6B4F"; penwidth=1.4; style=rounded; margin=18;
  "FIN-01" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-01\nConfigurar el plan de\ncuentas y los centros de\ncosto"];
  "FIN-02" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-02\nContabilizar un\ncomprobante"];
  "FIN-03" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-03\nAnular un comprobante o\nregistrar una nota"];
  "FIN-04" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-04\nCerrar el periodo contable"];
  "FIN-05" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-05\nClasificar costos y\ndistribuirlos por\nactividades"];
  "FIN-06" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-06\nElaborar y aprobar el\npresupuesto maestro"];
  "FIN-07" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-07\nGenerar los estados\nfinancieros"];
  "FIN-08" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-08\nCalcular indicadores y\nconsultar el tablero"];
  "FIN-09" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-09\nAnalizar estados:\nvertical, horizontal,\nfuentes y usos"];
  "FIN-10" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-10\nCalcular punto de\nequilibrio y palancas"];
  "FIN-11" [shape=ellipse, style="filled", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-11\nGestionar anticipos a\nproveedores"];
  "FIN-12" [shape=ellipse, style="filled,dashed", fillcolor="#EAF3EE", color="#2E6B4F", fontcolor="#1F2933", fontsize=10.5, label="FIN-12\nEmitir un informe de\nindicadores para crédito\n[función indicadores_credito]"];
}
{rank=sink; "AG_CON"; "AG_NEG"; "AG_EST"; "B2B";}
