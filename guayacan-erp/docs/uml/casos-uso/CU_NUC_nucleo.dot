"AUD" -> "NUC-06";
"OPE" -> "NUC-07";
"NUC-07" -> "AG_ORQ" [style=solid];
"NUC-07" -> "NUC-05" [style=dashed, arrowhead=vee, xlabel="«include»", fontsize=9.5, fontcolor="#6B7280", constraint=false];
"EST" -> "NUC-08";
"INS" -> "NUC-08";
"SCH" -> "NUC-09";
"NUC-09" -> "NOT" [style=solid];
"ADM" -> "NUC-10";
"NUC-10" -> "B2B" [style=solid];
}